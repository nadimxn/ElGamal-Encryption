<mxfile host="app.diagrams.net" type="device">
  <diagram name="Decryption Flowchart" id="Decryption-Flowchart">
    <mxGraphModel dx="1100" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1700" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="n2" value="Start" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="40" width="160" height="45" as="geometry"/></mxCell>
        <mxCell id="n3" value="Read ciphertext from the interface" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="120" width="320" height="50" as="geometry"/></mxCell>
        <mxCell id="n4" value="Private key available?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="250" y="205" width="300" height="70" as="geometry"/></mxCell>
        <mxCell id="n5" value="Parse each line as hexadecimal
c1 and c2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="310" width="320" height="50" as="geometry"/></mxCell>
        <mxCell id="n6" value="Format valid and
1 &lt;= c1, c2 &lt;= p - 1 ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="250" y="395" width="320" height="75" as="geometry"/></mxCell>
        <mxCell id="n7" value="For each block: compute
s = c1^x mod p" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="505" width="320" height="50" as="geometry"/></mxCell>
        <mxCell id="n8" value="Compute s^-1 mod p using the
Extended Euclidean Algorithm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="590" width="320" height="55" as="geometry"/></mxCell>
        <mxCell id="n9" value="Recover m = c2 * s^-1 mod p" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="680" width="320" height="50" as="geometry"/></mxCell>
        <mxCell id="n10" value="Convert m to bytes and remove
the 0x01 marker byte" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="765" width="320" height="50" as="geometry"/></mxCell>
        <mxCell id="n11" value="Marker byte present and
bytes decode as UTF-8 ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="250" y="850" width="330" height="75" as="geometry"/></mxCell>
        <mxCell id="n12" value="Concatenate blocks into the
recovered plaintext string" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="960" width="320" height="50" as="geometry"/></mxCell>
        <mxCell id="n13" value="Display recovered plaintext
and status" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="1045" width="320" height="55" as="geometry"/></mxCell>
        <mxCell id="n14" value="End" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="1135" width="160" height="45" as="geometry"/></mxCell>
