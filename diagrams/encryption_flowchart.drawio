<mxfile host="app.diagrams.net" type="device">
  <diagram name="Encryption Flowchart" id="Encryption-Flowchart">
    <mxGraphModel dx="1100" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1700" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="n2" value="Start" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="40" width="160" height="45" as="geometry"/></mxCell>
        <mxCell id="n3" value="Read plaintext from the interface" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="120" width="310" height="50" as="geometry"/></mxCell>
        <mxCell id="n4" value="Public key available?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="250" y="205" width="300" height="70" as="geometry"/></mxCell>
        <mxCell id="n5" value="Plaintext is non-empty?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="250" y="310" width="300" height="70" as="geometry"/></mxCell>
        <mxCell id="n6" value="Encode plaintext as UTF-8 bytes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="415" width="310" height="50" as="geometry"/></mxCell>
        <mxCell id="n7" value="Split bytes into blocks of
(bit_length(p) - 1)/8 - 1 bytes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="500" width="310" height="50" as="geometry"/></mxCell>
        <mxCell id="n8" value="Prefix each block with 0x01 and
convert to integer m" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="585" width="310" height="50" as="geometry"/></mxCell>
        <mxCell id="n9" value="Every block satisfies 0 &lt; m &lt; p ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="250" y="670" width="330" height="70" as="geometry"/></mxCell>
        <mxCell id="n10" value="For each block: draw a fresh
ephemeral k in [2, p-2] from secrets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="775" width="330" height="55" as="geometry"/></mxCell>
        <mxCell id="n11" value="Compute c1 = g^k mod p" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="865" width="310" height="50" as="geometry"/></mxCell>
        <mxCell id="n12" value="Compute c2 = m * y^k mod p" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="950" width="310" height="50" as="geometry"/></mxCell>
        <mxCell id="n13" value="Serialise blocks as
'c1:c2' in hexadecimal, one per line" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="1035" width="310" height="50" as="geometry"/></mxCell>
        <mxCell id="n14" value="Display ciphertext and status" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="1120" width="310" height="50" as="geometry"/></mxCell>
        <mxCell id="n15" value="End" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="1205" width="160" height="45" as="geometry"/></mxCell>
        <mxCell id="n16" value="Error: generate or import
a key pair first" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="640" y="160" width="230" height="55" as="geometry"/></mxCell>
        <mxCell id="n17" value="Error: plaintext is empty" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="640" y="255" width="230" height="45" as="geometry"/></mxCell>
        <mxCell id="n18" value="Raise MessageTooLargeError
